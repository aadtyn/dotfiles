# Ghostty Configuration

# Font settings
font-family = "JetBrains Mono"
font-size = 14

# Window settings
window-width = 120
window-height = 30
window-padding-x = 10
window-padding-y = 10

# Theme
theme = "Gruvbox Dark"

# Cursor
cursor-style = "block"
cursor-style-blink = false

# Shell integration
shell-integration = "zsh"

# Mouse
mouse-hide-while-typing = true

# Scrollback
scrollback-limit = 100000

# Copy/paste
copy-on-select = false

# Key bindings
keybind = cmd+c=copy_to_clipboard
keybind = cmd+v=paste_from_clipboard
keybind = cmd+t=new_tab
keybind = cmd+w=close_surface
keybind = cmd+n=new_window
# Fix sending shift+enter for Claude Code
keybind = shift+enter=text:\x1b\r
keybind = global:unconsumed:cmd+alt+ctrl+t=new_window


keybind = cmd+h=goto_split:left
keybind = cmd+j=goto_split:down
keybind = cmd+k=goto_split:up
keybind = cmd+l=goto_split:right
keybind = cmd+shift+space=toggle_split_zoom
keybind = cmd+enter=new_split:auto
